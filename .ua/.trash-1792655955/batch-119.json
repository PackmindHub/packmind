      "type": "file",
      "name": "InstallStateSigner.ts",
      "filePath": "packages/git/src/infra/repositories/github/auth/InstallStateSigner.ts",
      "summary": "Implements HMAC-SHA256 signing and verification of short-TTL state tokens for the GitHub App installation and manifest flows, carrying org, user, nonce, expiry, app/provider ids and display name tamper-proof through the GitHub redirect.",
      "tags": [
        "security",
        "authentication",
        "github-app",
        "cryptography",
        "service"
      ],
      "complexity": "moderate",
      "languageNotes": "Verification re-signs the decoded raw JSON bytes and uses crypto.timingSafeEqual, so key ordering does not matter and comparisons resist timing attacks."
    },
