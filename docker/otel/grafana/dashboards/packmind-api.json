{
  "uid": "packmind-api-red",
  "title": "Packmind API — latency & throughput",
  "tags": ["packmind", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "description": "Defaults to the otel-lgtm datasource. Switch it when pointing this dashboard at Grafana Cloud, whose datasource uids differ."
      },
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds}" },
        "query": "label_values(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}, span_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latency percentiles per endpoint",
      "description": "Server spans only. Straight from Tempo's span metrics — no instrumentation of our own. Empty panel usually means no traffic in the window, not a broken setup: rate() over an idle period is NaN.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 5 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50 {{span_name}}",
          "expr": "histogram_quantile(0.50, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95 {{span_name}}",
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99 {{span_name}}",
          "expr": "histogram_quantile(0.99, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{span_name}}",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors per second",
      "description": "Spans whose status is ERROR. Flat zero is the expected state.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{span_name}}",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Latency distribution — $endpoint",
      "description": "The full shape, not just quantiles. Two bands mean two behaviours (cache hit vs miss, warm vs cold pool) that percentiles average away.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "options": { "calculate": false, "yAxis": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "expr": "sum by (le) (rate(traces_spanmetrics_latency_bucket{span_name=\"$endpoint\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Database call latency (p95 / p99)",
      "description": "Client spans — pg.query and friends. When these track the endpoint percentiles above, the tail is the database rather than our code.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95 {{span_name}}",
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_CLIENT\"}[$__rate_interval])))"
        },
        {
          "refId": "B",
          "legendFormat": "p99 {{span_name}}",
          "expr": "histogram_quantile(0.99, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_CLIENT\"}[$__rate_interval])))"
        }
      ]
    }
  ]
}
