{
  "name": "spaces",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/spaces/src",
  "projectType": "library",
  "tags": ["env:node"],
  "// typecheck": "Overrides the nx.json command to also gate tsconfig.spec.json: the shared one covers tsconfig.lib.json only, which excludes specs and test/.",
  "targets": {
    "typecheck": {
      "options": {
        "command": "tsc --noEmit --project packages/spaces/tsconfig.lib.json && tsc --noEmit --project packages/spaces/tsconfig.spec.json"
      }
    },
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/spaces",
        "tsConfig": "packages/spaces/tsconfig.lib.json",
        "packageJson": "packages/spaces/package.json",
        "main": "packages/spaces/src/index.ts",
        "assets": ["packages/spaces/*.md"]
      }
    }
  }
}
